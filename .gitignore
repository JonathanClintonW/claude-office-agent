# dependencies and build output
node_modules/
dist/
**/media/ui/
*.vsix
*.tsbuildinfo
*.map
# licence/notice copies made inside the extension folder at build time (originals live at the root)
packages/vscode-extension/LICENSE
packages/vscode-extension/THIRD_PARTY_NOTICES.md

# caches and test output
coverage/
.vite/
.cache/
.eslintcache
.npm/
.turbo/
test-results/
playwright-report/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local Claude Code settings and data (may contain absolute paths with your username, or tokens)
.claude/settings.local.json
.claude/*.local.*
.claude/.credentials.json
.claude/projects/
.claude/sessions/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude.json
.claude.json.backup*
.credentials.json
# backups written by "agent-office install-hooks" next to a settings file
*.agent-office-backup-*

# Agent Office runtime data lives in ~/.agent-office (token, state, history journal, spool, pricing).
# Never commit a copy of it. Claude Code transcripts and the history journal are .jsonl files that
# hold session activity: tests generate theirs in a temp dir at runtime.
.agent-office/
.agent-office-test-*/
*.jsonl
ev-*-*-*.json
ev-*-*-*.json.claimed-*

# secrets and machine-specific files
.env
.env.*
!.env.example
.envrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.npmrc
.netrc
secrets/

# scratch output: temp folders, partial writes (docs/assets/screenshots holds the real README screenshots and is kept)
/tmp/
/temp/
/.tmp/
*.tmp
*.part

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
